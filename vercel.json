{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "bindings": [
        {
          "type": "service",
          "service": "nasa_query",
          "format": "url",
          "env": "NASA_QUERY_URL"
        }
      ]
    },
    "nasa_query": {
      "root": "nasa_query",
      "runtime": "rust"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
